#include<iostream>
using namespace std;

// Class Template
template <class T>
class Sample
{
    T a, b;

public:
    void accept()
    {
        cout << "Enter two values: ";
        cin >> a >> b;
    }

    void display()
    {
        cout << "First value: " << a << endl;
        cout << "Second value: " << b << endl;
    }
};

// Function Template
template <class T>
T add(T a, T b)
{
    return a + b;
}

int main()
{
    // Class Template Object
    Sample<int> s;

    s.accept();
    s.display();

    // Function Template
    int x, y;

    cout << "\nEnter two numbers for addition: ";
    cin >> x >> y;

    cout << "Addition = " << add(x, y);

    return 0;
}
